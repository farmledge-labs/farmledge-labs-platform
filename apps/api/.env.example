# Server
PORT=3000
NODE_ENV=development

# Authentication & Security
JWT_SECRET=change-me-in-production
PLATFORM_ADMIN_SECRET=change-me-in-production
# Comma-separated list of production origins allowed by CORS.
# Leave empty for dev/test (all origins are permitted when NODE_ENV != production).
ALLOWED_ORIGINS=https://app.farmledge.io,https://admin.farmledge.io

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Stellar Network
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_PLATFORM_SECRET=S... # Platform issuer keypair secret — signs lock/unlock txs

# API Keys & Secrets
LENDER_API_KEY_SALT=change-me-in-production

# AWS S3
S3_BUCKET=farmledge-dev
S3_REGION=us-east-1

